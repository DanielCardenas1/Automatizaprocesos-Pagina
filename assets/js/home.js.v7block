/* ============================================================
   V7 — COMPARACIÓN + RECORRIDOS VIVOS
   La sección enseña la diferencia y permite vivir ejemplos completos.
   ============================================================ */
const V6_EXAMPLES={
 vet:{name:'Veterinaria',brand:'VETCARE',url:'veterinaria-sanmartin.com',headline:'Cuidamos a tu mascota.',sub:'Atención, orientación y cuidado para cada etapa.',kicker:'VETERINARIA SAN MARTÍN',nav:['Servicios','Nosotros','Contacto'],cards:[['Consulta general','Agenda una valoración con el equipo.'],['Vacunación','Revisa servicios y próximos controles.'],['Farmacia','Consulta productos y disponibilidad.']],cta:'Agendar una cita',channels:[['Google','Viene buscando una respuesta.'],['Instagram','Vio una publicación y quiere saber más.'],['QR','Está en el punto físico y necesita resolver algo.'],['WhatsApp','Ya conoce el negocio y quiere atención.']],reasons:[['Consultar información','Necesita saber algo sobre su mascota.'],['Agendar una cita','Quiere encontrar un horario sin llamar.'],['Consultar tratamiento','Quiere revisar información que ya existe.']],reasonMore:[['Ver resultados','Quiere entender un examen reciente.'],['Consultar vacunas','Necesita confirmar un próximo control.'],['Hablar con el veterinario','Prefiere atención humana.']],questions:[{label:'¿Cómo se llama tu mascota?',type:'input',default:'Tobby',help:'Pedimos solo el dato necesario para encontrar la información correcta.'},{label:'¿Qué quieres consultar sobre Tobby?',options:[['Último control','Ver la información de la consulta más reciente.'],['Medicamentos','Revisar lo que aparece registrado.'],['Exámenes','Consultar resultados disponibles.']],more:[['Vacunas','Revisar el esquema registrado.'],['Próxima cita','Comprobar si existe un control pendiente.'],['Historial completo','Ver el resumen disponible.']]},{label:'Encontramos información de Tobby. ¿Qué quieres hacer ahora?',options:[['Agendar cita','Elegir un horario para continuar su atención.'],['Hablar con el veterinario','Enviar la consulta con el contexto reunido.'],['Recibir la información','Quedarte con el resumen encontrado.']],more:[['Consultar otra cosa','Volver a revisar otra parte del historial.'],['Comprar medicamento','Consultar disponibilidad en la farmacia.'],['Ver otra fecha','Buscar otro horario disponible.']]}],outcome:'Tobby llegó a una siguiente acción sin tener que explicar toda la historia otra vez.',finalQuestion:'¿Cómo quieres continuar con este resultado?',finalOptions:[['Agendar una cita','Llevar el contexto hasta la agenda.','agenda'],['Pedir una llamada','Enviar el contexto para que Daniel te contacte.','call']]},
 food:{name:'Comidas',brand:'LA ESQUINA',url:'laesquina.example',headline:'Come bien. Sin complicarte.',sub:'Mira, elige y pide con la información que necesitas.',kicker:'LA ESQUINA · RESTAURANTE',nav:['Menú','Reservas','Contacto'],cards:[['Menú del día','Conoce opciones, precios y disponibilidad.'],['Reservar','Encuentra una mesa para tu momento.'],['Pedir','Arma tu pedido sin repetir información.']],cta:'Ver el menú',channels:[['Google','Busca dónde comer.'],['Instagram','Vio un plato y quiere pedirlo.'],['QR','Está en la mesa y necesita decidir.'],['WhatsApp','Quiere hacer un pedido rápido.']],reasons:[['Elegir un plato','Necesita ayuda para decidir.'],['Hacer un pedido','Ya sabe qué quiere y quiere pedir.'],['Reservar una mesa','Quiere asegurar un espacio.']],reasonMore:[['Consultar domicilio','Quiere saber si llegamos a su zona.'],['Ver opciones vegetarianas','Tiene una preferencia concreta.'],['Pedir para un evento','Necesita varias opciones.']],questions:[{label:'¿Para qué momento estás buscando?',options:[['Almuerzo','Busca algo para comer ahora.'],['Cena','Está planeando la comida de la noche.'],['Algo rápido','Quiere resolver sin complicarse.']],more:[['Evento','Necesita comida para varias personas.'],['Reunión','Busca una opción para compartir.'],['Fin de semana','Quiere reservar o pedir con tiempo.']]},{label:'¿Qué quieres priorizar?',options:[['Plato principal','Quiere elegir entre las opciones principales.'],['Opción vegetariana','Tiene una preferencia alimentaria.'],['Domicilio','Quiere recibirlo donde está.']],more:[['Precio','Quiere una opción dentro de un presupuesto.'],['Para compartir','Busca varias porciones.'],['Reservar','Prefiere asegurar una mesa.']]},{label:'Encontramos una opción que encaja. ¿Qué quieres hacer?',options:[['Confirmar pedido','Pasar la selección al negocio.'],['Reservar mesa','Buscar un horario disponible.'],['Ver otras opciones','Comparar antes de decidir.']],more:[['Hablar con el restaurante','Enviar la solicitud con contexto.'],['Cambiar preferencias','Ajustar la búsqueda.'],['Pedir para evento','Continuar con una solicitud especial.']]}],outcome:'La persona pasó de una intención general a una decisión concreta y el equipo recibe el pedido con contexto.',finalQuestion:'¿Cómo quieres continuar con esta solicitud?',finalOptions:[['Agendar una conversación','Hablar con Daniel sobre cómo construir algo así.','agenda'],['Pedir una llamada','Enviar la solicitud y pedir que te contacten.','call']]},
 realestate:{name:'Inmobiliaria',brand:'NODO INMOBILIARIO',url:'nodo.example',headline:'Encuentra un lugar que encaje contigo.',sub:'Filtramos lo importante antes de mostrarte opciones.',kicker:'NODO INMOBILIARIO',nav:['Comprar','Arrendar','Vender'],cards:[['Propiedades','Explora opciones según tus criterios.'],['Asesoría','Habla con alguien con contexto.'],['Visitas','Agenda cuando encuentres una opción.']],cta:'Encontrar propiedad',channels:[['Google','Busca una vivienda con una necesidad concreta.'],['Portal inmobiliario','Llega desde una propiedad que le interesó.'],['Instagram','Descubrió un inmueble y quiere conocerlo.'],['WhatsApp','Ya tiene una opción y quiere avanzar.']],reasons:[['Comprar','Busca una vivienda para comprar.'],['Arrendar','Necesita encontrar dónde vivir.'],['Agendar visita','Ya encontró algo que le interesa.']],reasonMore:[['Invertir','Busca una oportunidad de inversión.'],['Vender','Quiere conocer el proceso para vender.'],['Comparar opciones','Todavía está explorando el mercado.']],questions:[{label:'¿En qué ciudad estás buscando?',options:[['Tunja','Busca una propiedad en Tunja.'],['Bogotá','Busca una propiedad en Bogotá.'],['Paipa','Busca una propiedad en Paipa.']],more:[['Duitama','Busca una propiedad en Duitama.'],['Otra ciudad','Quiere especificar otra ubicación.'],['Todavía no lo sé','Primero quiere entender las opciones.']]},{label:'¿Qué quieres priorizar?',options:[['3 habitaciones','Necesita espacio para una familia.'],['Buena ubicación','La zona es una prioridad.'],['Presupuesto','Quiere mantenerse dentro de un rango.']],more:[['Parqueadero','Necesita estacionamiento.'],['Inversión','Busca potencial de rentabilidad.'],['Entrega inmediata','Quiere una opción disponible pronto.']]},{label:'Encontramos opciones compatibles. ¿Qué quieres hacer ahora?',options:[['Ver propiedades','Revisar las opciones que encajan.'],['Agendar una visita','Conocer una propiedad en persona.'],['Hablar con un asesor','Recibir ayuda con el contexto ya reunido.']],more:[['Comparar dos opciones','Poner alternativas lado a lado.'],['Cambiar criterios','Ajustar la búsqueda.'],['Guardar la búsqueda','Continuar después sin empezar de cero.']]}],outcome:'El equipo recibe un perfil de búsqueda en lugar de un mensaje genérico y puede continuar desde el contexto correcto.',finalQuestion:'Encontramos una ruta. ¿Qué debería pasar después?',finalOptions:[['Agendar una visita','Llevar tus criterios hasta una agenda.','agenda'],['Pedir una llamada','Enviar tu perfil y pedir que te contacten.','call']]},
 commerce:{name:'Comercio',brand:'TIENDA',url:'tienda.example',headline:'Encuentra lo que realmente necesitas.',sub:'Menos opciones al azar. Más ayuda para elegir.',kicker:'TIENDA · EXPERIENCIA DE COMPRA',nav:['Productos','Guía','Contacto'],cards:[['Catálogo','Explora productos disponibles.'],['Guía de elección','Encuentra una opción según tu necesidad.'],['Compra','Avanza con lo que ya decidiste.']],cta:'Encontrar producto',channels:[['Google','Busca una solución.'],['Instagram','Descubrió un producto.'],['QR','Está frente al producto y quiere comparar.'],['WhatsApp','Quiere confirmar antes de comprar.']],reasons:[['Elegir un producto','No sabe cuál opción le conviene.'],['Comparar','Tiene varias alternativas.'],['Comprar','Ya sabe qué necesita y quiere avanzar.']],reasonMore:[['Consultar disponibilidad','Quiere saber qué hay antes de ir.'],['Conocer precio','Necesita confirmar cuánto cuesta.'],['Hablar con asesor','Prefiere ayuda antes de decidir.']],questions:[{label:'¿Para quién estás comprando?',options:[['Para mi negocio','La compra responde a una necesidad del negocio.'],['Para mí','Busca algo para uso personal.'],['Para regalar','Necesita elegir pensando en otra persona.']],more:[['Para mi equipo','Compra para varias personas.'],['Para un proyecto','Tiene un uso específico.'],['Todavía no lo sé','Primero necesita orientación.']]},{label:'¿Qué quieres priorizar?',options:[['Calidad','Quiere una opción confiable.'],['Precio','Quiere cuidar el presupuesto.'],['Rapidez','Necesita resolver pronto.']],more:[['Durabilidad','Busca que dure más.'],['Diseño','La apariencia es importante.'],['Disponibilidad','Quiere comprar lo que esté listo.']]},{label:'Encontramos opciones que encajan. ¿Qué quieres hacer?',options:[['Comparar opciones','Ver diferencias antes de decidir.'],['Comprar','Avanzar con la elección.'],['Hablar con un asesor','Enviar la información reunida.']],more:[['Guardar selección','Continuar después.'],['Ver alternativas','Explorar otras opciones.'],['Consultar disponibilidad','Confirmar inventario.']]}],outcome:'La persona recibe una recomendación más clara y el negocio entiende qué estaba buscando antes de atenderla.',finalQuestion:'¿Cómo quieres continuar?',finalOptions:[['Agendar una conversación','Hablar con Daniel sobre el recorrido.','agenda'],['Pedir una llamada','Enviar la solicitud y pedir contacto.','call']]}
};
let v6={sector:'vet',mode:'page',step:0,data:{},channel:null,reason:null,more:false,complete:false,finalAction:null};
function v6el(id){return document.getElementById(id)}
function v6escape(v){return escapeHTML(String(v))}
function v6reset(){v6.step=0;v6.data={};v6.channel=null;v6.reason=null;v6.more=false;v6.complete=false;v6.finalAction=null}
function v6setSector(key){v6.sector=key;v6.mode='page';v6reset();const d=V6_EXAMPLES[key];document.querySelectorAll('.v6-sector').forEach(b=>b.classList.toggle('is-active',b.dataset.v6Sector===key));v6el('v6SelectedSector').textContent=d.name;v6el('v6LiveBrand').textContent=d.brand;v6renderMode();v6renderLive();}
function v6pageHTML(d){return `<div class="v6-page-nav"><div class="v6-page-brand">${v6escape(d.brand)}</div><div class="v6-page-navlinks">${d.nav.map(n=>`<span>${v6escape(n)}</span>`).join('')}</div><span class="v6-page-menu">☰</span></div><div class="v6-page-hero"><div><span class="v6-page-kicker">${v6escape(d.kicker)}</span><h3>${v6escape(d.headline)}</h3><p>${v6escape(d.sub)}</p><span class="v6-page-cta">${v6escape(d.cta)} →</span></div><div class="v6-page-art"><span class="v6-page-art-label">SITIO WEB</span><div class="v6-page-art-lines"><i></i><i></i><i></i></div><div class="v6-page-art-card"><b>Información</b><span>Servicios · Horarios · Contacto</span></div></div></div><div class="v6-page-services"><span>LO QUE ENCUENTRAS</span><div class="v6-page-cards">${d.cards.map(c=>`<div class="v6-page-card"><b>${v6escape(c[0])}</b><span>${v6escape(c[1])}</span></div>`).join('')}</div></div><div class="v6-page-footer"><span>${v6escape(d.brand)}</span><span>Información · Horarios · Contacto</span></div>`}
function v6renderMode(){const d=V6_EXAMPLES[v6.sector],stage=v6el('v6Stage'),web=v6el('v6Webpage');if(v6.mode==='page'){stage.classList.remove('is-journey');web.innerHTML=v6pageHTML(d);v6el('v6Url').textContent=d.url;v6el('v6SideLabel').textContent='PÁGINA WEB';v6el('v6SideTitle').textContent='El cliente encuentra información.';v6el('v6SideText').textContent='Presenta el negocio, explica lo que ofrece y deja abierta la decisión de qué hacer después.';v6el('v6MiniFlow').innerHTML='<span>llega</span><i>→</i><span>explora</span><i>→</i><span>decide</span>';v6el('v6LessonTitle').textContent='Una página puede ser una pieza.';v6el('v6LessonText').textContent='Puede presentar muy bien un negocio. Pero si sabemos qué necesita conseguir la persona, podemos diseñar lo que ocurre después en lugar de dejarla sola frente a la pantalla.';}else{stage.classList.add('is-journey');web.innerHTML=v6liveClientHTML(d);v6el('v6Url').textContent=d.url+'/experiencia';v6el('v6SideLabel').textContent='RECORRIDO';v6el('v6SideTitle').textContent='La experiencia se adapta a la necesidad.';v6el('v6SideText').textContent='El cliente no tiene que descubrir qué hacer solo. La experiencia pregunta lo necesario, usa el contexto y lo lleva hacia una acción concreta.';v6el('v6MiniFlow').innerHTML='<span>canal</span><i>→</i><span>necesidad</span><i>→</i><span>contexto</span><i>→</i><span>acción</span>';v6el('v6LessonTitle').textContent='La diferencia aparece cuando diseñamos lo que ocurre después.';v6el('v6LessonText').textContent='No se trata de tener más pantallas. Se trata de que cada respuesta tenga un propósito y ayude a la persona y al negocio a llegar al siguiente paso.';v6bindLiveActions();}}
function v6liveClientHTML(d){return `<div class="v6-live-ui"><div class="v6-live-kicker">${v6escape(d.kicker)} · EXPERIENCIA</div>${v6renderLiveBody(d)}</div>`}
function v6renderLive(){const d=V6_EXAMPLES[v6.sector];if(v6.mode!=='journey')return;const host=v6el('v6LiveClientContent');if(host)host.innerHTML=v6renderLiveBody(d,true);v6renderLiveProgress();v6renderLiveLog();v6renderLiveRecord();v6renderLiveReveal()}
function v6renderLiveBody(d,embedded=false){let body='';if(v6.complete){body=`<div class="v6-live-kicker">RESULTADO · ${v6escape(d.name)}</div><h3>${v6escape(d.outcome)}</h3><p>La interacción terminó con contexto suficiente para que el siguiente paso sea fácil para la persona y accionable para el negocio.</p><div class="v6-final-result"><strong>✓ Recorrido completado</strong><p>${v6escape(v6.data['Acción final']||'El resultado quedó listo para continuar.')}</p></div><div class="v6-final-actions"><button class="v6-final-btn primary" data-v6-action="go-agenda">Agendar una conversación</button><button class="v6-final-btn secondary" data-v6-action="go-call">Pedir una llamada</button><button class="v6-back" data-v6-action="restart">↺ Probar otra vez</button></div>`;return embedded?body:body}
if(v6.step===0){body=`<div class="v6-live-kicker">${v6escape(d.name)} · PUNTO DE ENTRADA</div><h3>¿Cómo llegó tu cliente?</h3><p>Antes de preguntarle cualquier cosa, diseñamos el contexto. Elige el canal por el que podría llegar.</p><div class="v6-question-label">ELIGE UN CANAL</div><div class="v6-choice-grid">${d.channels.map((c,i)=>`<button class="v6-choice" data-v6-action="channel" data-v6-index="${i}"><strong>${v6escape(c[0])}</strong><small>${v6escape(c[1])}</small></button>`).join('')}</div>`}
else if(v6.step===1){body=`<div class="v6-live-kicker">${v6escape(d.name)} · ${v6escape(v6.channel)}</div><h3>¿Por qué está aquí?</h3><p>La misma persona puede llegar por motivos distintos. La experiencia empieza por entender qué quiere conseguir.</p><div class="v6-question-label">¿QUÉ NECESITA?</div><div class="v6-choice-grid">${v6options(d.reasons,d.reasonMore,v6.more,'reason')}</div>${v6moreButton(d.reasonMore)}`}
else if(v6.step>=2 && v6.step<2+d.questions.length){const q=d.questions[v6.step-2];body=`<div class="v6-live-kicker">${v6escape(d.name)} · CONTEXTO</div><h3>${v6escape(q.label)}</h3><p>${v6escape(q.help||'La respuesta anterior permite que la siguiente decisión tenga sentido.')}</p>${q.type==='input'?`<div class="v6-field-row"><input id="v6LiveInput" value="" placeholder="${v6escape(q.default||'Escribe aquí')}"><button data-v6-action="live-input">Continuar</button></div>`:`<div class="v6-choice-grid">${v6options(q.options,q.more,v6.more,'question')}</div>${v6moreButton(q.more)}`}`}
else {const actionIndex=2+d.questions.length;body=`<div class="v6-live-kicker">${v6escape(d.name)} · SIGUIENTE PASO</div><h3>${v6escape(d.finalQuestion)}</h3><p>El recorrido no termina en “resultado preparado”. Si quieres, la información puede llevarte directamente a la siguiente conversación.</p><div class="v6-choice-grid">${d.finalOptions.map((o,i)=>`<button class="v6-choice" data-v6-action="final" data-v6-index="${i}"><strong>${v6escape(o[0])}</strong><small>${v6escape(o[1])}</small></button>`).join('')}</div>`}
return body}
function v6options(primary,more,show,kind){const arr=show?[...primary,...more]:primary;return arr.map((o,i)=>`<button class="v6-choice" data-v6-action="${kind}" data-v6-index="${i}"><strong>${v6escape(o[0])}</strong><small>${v6escape(o[1])}</small></button>`).join('')}
function v6moreButton(more){return more&&more.length?`<button class="v6-more" data-v6-action="more">＋ ¿Quieres ver más opciones?</button>`:''}
function v6bindLiveActions(){document.querySelectorAll('[data-v6-action]').forEach(b=>b.addEventListener('click',()=>{const action=b.dataset.v6Action,d=V6_EXAMPLES[v6.sector],i=Number(b.dataset.v6Index);if(action==='channel'){v6.channel=d.channels[i][0];v6.data['Canal de llegada']=v6.channel;v6.step=1;v6.more=false;v6logLive('Entrada identificada',`${v6.channel} · contexto de llegada`)}else if(action==='reason'){const arr=v6.more?[...d.reasons,...d.reasonMore]:d.reasons;v6.reason=arr[i][0];v6.data['Necesidad']=v6.reason;v6.step=2;v6.more=false;v6logLive('Necesidad definida',v6.reason)}else if(action==='question'){const q=d.questions[v6.step-2],arr=v6.more?[...(q.options||[]),...(q.more||[])]:q.options||[];const selected=arr[i]?.[0]||'Otra opción';v6.data[q.label]=selected;v6.more=false;v6.step++;v6logLive('Contexto capturado',`${q.label} · ${selected}`);if(v6.step>=2+d.questions.length)v6logLive('Sistema listo','La información ya puede orientar la siguiente acción')}else if(action==='live-input'){const q=d.questions[v6.step-2],input=v6el('v6LiveInput'),val=(input?.value||q.default||'Tobby').trim();v6.data[q.label]=val;v6.step++;v6logLive('Dato capturado',`${q.label} · ${val}`);v6logLive('Base de datos consultada','Buscando información relacionada y contexto disponible')}else if(action==='more'){v6.more=true}else if(action==='final'){const o=d.finalOptions[i];v6.data['Acción final']=o[0];v6.finalAction=o[2];v6.complete=true;v6logLive('Siguiente paso elegido',o[0]);v6logLive('Contexto entregable','La solicitud puede continuar sin volver a empezar')}else if(action==='go-agenda'){v6sendToContact('agenda')}else if(action==='go-call'){v6sendToContact('call')}else if(action==='restart'){v6reset()}v6renderLive();v6bindLiveActions();}));}
function v6renderLiveProgress(){const box=v6el('v6LiveProgress');if(!box)return;const total=5,cur=v6.complete?5:Math.min(4,Math.max(1,v6.step+1));box.innerHTML=Array.from({length:total},(_,i)=>`${i?'<i></i>':''}<span class="${i+1<cur?'done ':''}${i+1===cur?'on':''}">0${i+1}</span>`).join('')}
function v6logLive(title,detail){const box=v6el('v6LiveLog');if(!box)return;if(box.querySelector('.v6-live-empty'))box.innerHTML='';const row=document.createElement('div');row.className='v6-live-log-item';row.innerHTML=`<i></i><div><strong>${v6escape(title)}</strong><small>${v6escape(detail)}</small></div>`;box.appendChild(row);box.scrollTop=box.scrollHeight}
function v6renderLiveLog(){const box=v6el('v6LiveLog');if(!box)return;if(!v6.data||Object.keys(v6.data).length===0){box.innerHTML='<div class="v6-live-empty">La experiencia está esperando a su primera interacción.</div>';return}box.innerHTML='';Object.entries(v6.data).forEach(([k,val])=>{const row=document.createElement('div');row.className='v6-live-log-item';row.innerHTML=`<i></i><div><strong>${v6escape(k)}</strong><small>${v6escape(val)}</small></div>`;box.appendChild(row)})}
function v6renderLiveRecord(){const box=v6el('v6LiveRecord');if(!box)return;const d=V6_EXAMPLES[v6.sector],rows=Object.entries(v6.data);if(!rows.length){box.innerHTML='<div class="v6-live-record-empty"><span>REGISTRO DEL NEGOCIO</span><strong>Cuando tu cliente avance, aquí se irá construyendo la información que realmente necesitas.</strong></div>';return}box.innerHTML=`<div class="v6-live-record-head"><span>registro del recorrido</span><span>${v6escape(d.brand)}</span></div>${rows.map(([k,v])=>`<div class="v6-live-record-row"><span>${v6escape(k)}</span><b>${v6escape(v)}</b></div>`).join('')}<div class="v6-live-record-row"><span>Estado</span><b>${v6.complete?'✓ siguiente paso listo':'En construcción'}</b></div>`}
function v6renderLiveReveal(){const box=v6el('v6LiveReveal'),d=V6_EXAMPLES[v6.sector];if(!box)return;const has=Object.keys(v6.data).length>0;box.classList.toggle('is-ready',v6.complete);v6el('v6RevealClient').textContent=v6.complete?d.outcome:(has?'Tu cliente ya está avanzando con menos esfuerzo.':'Tu cliente todavía no ha comenzado.');v6el('v6RevealBusiness').textContent=v6.complete?'El negocio recibe contexto suficiente para continuar sin empezar de cero.':(has?'Cada respuesta se convierte en información útil para el negocio.':'Cuando el cliente avance, el negocio empezará a recibir contexto.');v6el('v6LiveFinalCta').innerHTML=v6.complete?`<div class="v6-reveal-final"><strong>El recorrido puede terminar aquí para tu cliente, pero no para el negocio.</strong><span>Ahora podemos llevar este contexto a una conversación real.</span><div><button class="v6-final-btn primary" data-v6-action="go-agenda">Quiero diseñar este recorrido</button><button class="v6-final-btn secondary" data-v6-action="go-call">Prefiero que me llamen</button></div></div>`:''}
function v6sendToContact(kind){const input=v6el('heroInput');const d=V6_EXAMPLES[v6.sector];const msg=kind==='agenda'?`Quiero hablar con Daniel sobre un recorrido digital para una ${d.name.toLowerCase()}. Acabo de probar el ejemplo y quiero diseñar algo similar para mi negocio.`:`Quiero pedir una llamada a Daniel para hablar sobre un recorrido digital para una ${d.name.toLowerCase()}.`;if(input){input.value=msg;input.dispatchEvent(new Event('input',{bubbles:true}));v6el('diagnostico')?.scrollIntoView({behavior:'smooth',block:'start'});setTimeout(()=>input.focus(),650)}else{window.open('https://wa.me/573005333763?text='+encodeURIComponent(msg),'_blank')}}
function v6bind(){document.querySelectorAll('.v6-sector').forEach(b=>b.addEventListener('click',()=>v6setSector(b.dataset.v6Sector)));document.querySelectorAll('.v6-mode').forEach(b=>b.addEventListener('click',()=>{v6.mode=b.dataset.v6Mode;v6reset();document.querySelectorAll('.v6-mode').forEach(x=>x.classList.toggle('is-active',x===b));v6renderMode();v6renderLive();if(v6.mode==='journey')v6el('v6LiveDemo')?.scrollIntoView({behavior:'smooth',block:'center'});}));v6setSector('vet')}
document.addEventListener('DOMContentLoaded',v6bind);
